# ── Telegraph node (live testnet) ─────────────────────────────────────
TELEGRAPH_NODE_URL=https://devnode.telegraphprotocol.com
# Burner wallet used ONLY to sign x402 USDC payments on Base Sepolia. Never reuse a real wallet.
TELEGRAPH_EVM_PRIVATE_KEY=0x...

# ── Database ─────────────────────────────────────────────────────────
# SQLite (default): file path. Postgres: postgres://... (see DECISIONS.md)
DATABASE_URL=file:./data/zengawd.sqlite

# ── Attestor (server-side only) — signs verdicts into ZengawdPolicy ──
ZENGAWD_ATTESTOR_PRIVATE_KEY=0x...
ZENGAWD_POLICY_ADDRESS=0x...
ZENGAWD_POLICY_CHAIN_ID=84532
RPC_URL_84532=https://sepolia.base.org
RPC_URL_8453=https://mainnet.base.org
RPC_URL_1=https://ethereum-rpc.publicnode.com

# ── Watcher ──────────────────────────────────────────────────────────
WATCHER_INTERVAL_MS=600000
WATCHER_LOOKBACK_BLOCKS=200000

# ── Calibration job ──────────────────────────────────────────────────
CALIBRATION_INTERVAL_MS=3600000

# ── Optional ─────────────────────────────────────────────────────────
# Send min_confidence / deadline_ms as `context` hints to the Engine (see DECISIONS.md 2.1)
TELEGRAPH_SEND_ROUTING_HINTS=true
# Safe module used by the watcher for opted-in auto-revocation
ZENGAWD_GUARD_MODULE_ADDRESS=0x...
# Operator key allowed on the module (defaults to the attestor key)
ZENGAWD_OPERATOR_PRIVATE_KEY=0x...

# ── Telegraph miner surface (/api/telegraph/ask) ──────────────────────
# Allow the registered miner endpoint to run fresh, paid pipelines. Off by default: with it "true",
# routed network traffic spends real USDC from TELEGRAPH_EVM_PRIVATE_KEY on every uncached question.
TELEGRAPH_MINER_LIVE=false
# Serve a stored verdict when it is younger than this (seconds). Matches ZengawdPolicy maxVerdictAge.
TELEGRAPH_MINER_CACHE_TTL_SEC=900
# Hard ceiling on fresh paid runs per hour, per instance.
TELEGRAPH_MINER_MAX_LIVE_PER_HOUR=6
# Chain assumed when a caller does not supply chainId.
TELEGRAPH_MINER_CHAIN_ID=1
